# Supabase → Project Settings → API keys. Both values are public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Claude API key for the AI helpers (console.anthropic.com). Without it the app
# still works; AI buttons show an error and projects can turn AI off.
ANTHROPIC_API_KEY=

# Optional model overrides
# AI_MODEL_ASSIST=claude-sonnet-5-5
# AI_MODEL_SUMMARY=claude-opus-5-5
